{
  "version": 1,
  "views": [
    {
      "id": "main",
      "origins": ["https://app.bunaway.local"],
      "commands": ["memo.save", "memo.read"],
      "events": ["memo.saved"],
      "host": {
        "permissions": [
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          },
          {
            "identifier": "storage:write-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          }
        ]
      }
    }
  ],
  "backend": {
    "permissions": []
  }
}
