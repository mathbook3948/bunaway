{
  "version": 1,
  "views": [
    {
      "id": "main",
      "origins": ["https://app.bunaway.local"],
      "commands": [
        "test.echo",
        "test.ping",
        "test.count",
        "test.hold",
        "test.writeNote",
        "test.readNote",
        "test.readEscape",
        "test.tempRead",
        "test.tempWrite",
        "test.capabilities",
        "test.log",
        "test.emit",
        "test.hostCancel",
        "test.report",
        "memo.save",
        "memo.read",
        "test.fail"
      ],
      "events": ["test.changed", "memo.saved"],
      "host": {
        "permissions": [
          "log.write",
          "storage.readText",
          "storage.writeText",
          "capabilities.get"
        ]
      }
    },
    {
      "id": "editor",
      "origins": ["https://app.bunaway.local"],
      "commands": ["test.report", "memo.save", "memo.read"],
      "events": ["memo.saved"],
      "host": {
        "permissions": [
          "log.write",
          "storage.readText",
          "storage.writeText",
          "capabilities.get"
        ]
      }
    },
    {
      "id": "reader",
      "origins": ["https://app.bunaway.local"],
      "commands": [
        "test.echo",
        "test.ping",
        "test.hold",
        "test.readNote",
        "test.log",
        "test.report",
        "memo.read"
      ],
      "events": ["memo.saved"],
      "host": {
        "permissions": [
          "storage.readText",
          "storage.writeText",
          "capabilities.get"
        ]
      }
    }
  ],
  "backend": {
    "permissions": [
      "log.write",
      "storage.readText",
      "storage.writeText",
      "capabilities.get"
    ]
  }
}
