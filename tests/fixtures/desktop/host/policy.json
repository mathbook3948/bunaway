{
  "version": 1,
  "views": [
    {
      "id": "main",
      "origins": ["https://app.bunaway.local"],
      "commands": [
        "test.echo",
        "test.ping",
        "test.count",
        "test.hold",
        "test.writeNote",
        "test.readNote",
        "test.readEscape",
        "test.tempRead",
        "test.tempWrite",
        "test.capabilities",
        "test.log",
        "test.emit",
        "test.hostCancel",
        "test.report",
        "memo.save",
        "memo.read",
        "test.fail"
      ],
      "events": ["test.changed", "memo.saved"],
      "host": {
        "permissions": [
          "log:write",
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          },
          {
            "identifier": "storage:write-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          },
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "temp",
                "pathPrefix": ""
              }
            ]
          },
          {
            "identifier": "storage:write-text",
            "allow": [
              {
                "scope": "temp",
                "pathPrefix": ""
              }
            ]
          },
          "capabilities:get"
        ]
      }
    },
    {
      "id": "editor",
      "origins": ["https://app.bunaway.local"],
      "commands": ["test.report", "memo.save", "memo.read"],
      "events": ["memo.saved"],
      "host": {
        "permissions": [
          "log:write",
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          },
          {
            "identifier": "storage:write-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          },
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "temp",
                "pathPrefix": ""
              }
            ]
          },
          {
            "identifier": "storage:write-text",
            "allow": [
              {
                "scope": "temp",
                "pathPrefix": ""
              }
            ]
          },
          "capabilities:get"
        ]
      }
    },
    {
      "id": "reader",
      "origins": ["https://app.bunaway.local"],
      "commands": [
        "test.echo",
        "test.ping",
        "test.hold",
        "test.writeNote",
        "test.readNote",
        "test.log",
        "test.report",
        "memo.read"
      ],
      "events": ["memo.saved"],
      "host": {
        "permissions": [
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "appData",
                "pathPrefix": "notes"
              }
            ]
          },
          {
            "identifier": "storage:read-text",
            "allow": [
              {
                "scope": "temp",
                "pathPrefix": ""
              }
            ]
          },
          {
            "identifier": "storage:write-text",
            "allow": [
              {
                "scope": "temp",
                "pathPrefix": ""
              }
            ]
          },
          "capabilities:get"
        ]
      }
    }
  ],
  "backend": {
    "permissions": [
      "log:write",
      {
        "identifier": "storage:read-text",
        "allow": [
          {
            "scope": "appData",
            "pathPrefix": ""
          }
        ]
      },
      {
        "identifier": "storage:write-text",
        "allow": [
          {
            "scope": "appData",
            "pathPrefix": ""
          }
        ]
      },
      {
        "identifier": "storage:read-text",
        "allow": [
          {
            "scope": "temp",
            "pathPrefix": ""
          }
        ]
      },
      {
        "identifier": "storage:write-text",
        "allow": [
          {
            "scope": "temp",
            "pathPrefix": ""
          }
        ]
      },
      "capabilities:get"
    ]
  }
}
