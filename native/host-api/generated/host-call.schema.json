{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 128
    },
    "payload": {}
  },
  "required": ["operation", "payload"],
  "additionalProperties": false
}
