{
  "windows.list": {
    "input": {
      "const": null
    },
    "output": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
          },
          "open": {
            "type": "boolean"
          }
        },
        "required": ["view", "open"],
        "additionalProperties": false
      }
    }
  },
  "windows.create": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.recreate": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.show": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.hide": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.focus": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.close": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        }
      },
      "required": ["view"],
      "additionalProperties": false
    },
    "output": {
      "type": "boolean"
    }
  },
  "windows.setSize": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        },
        "width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 4096
        }
      },
      "required": ["view", "width", "height"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.setPosition": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        },
        "x": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "y": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      },
      "required": ["view", "x", "y"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.setFullscreen": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        },
        "fullscreen": {
          "type": "boolean"
        }
      },
      "required": ["view", "fullscreen"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "windows.setCloseConfirmation": {
    "input": {
      "type": "object",
      "properties": {
        "view": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
        },
        "message": {
          "anyOf": [
            {
              "const": null
            },
            {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^\\u0000]+$(?![\\s\\S])"
            }
          ]
        }
      },
      "required": ["view", "message"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "storage.readText": {
    "input": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": ["appData", "temp"]
        },
        "path": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000\\r\\n]+$(?![\\s\\S])"
        }
      },
      "required": ["scope", "path"],
      "additionalProperties": false
    },
    "output": {
      "type": "string"
    }
  },
  "storage.writeText": {
    "input": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": ["appData", "temp"]
        },
        "path": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?!/)(?![A-Za-z]:)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000\\r\\n]+$(?![\\s\\S])"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["scope", "path", "text"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "log.write": {
    "input": {
      "type": "object",
      "properties": {
        "level": {
          "enum": ["debug", "info", "warn", "error"]
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "details": {}
      },
      "required": ["level", "message"],
      "additionalProperties": false
    },
    "output": {
      "const": null
    }
  },
  "capabilities.get": {
    "input": {
      "const": null
    },
    "output": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
            "maxLength": 128
          },
          "support": {
            "enum": ["supported", "experimental", "unsupported"]
          },
          "permission": {
            "enum": ["granted", "denied", "prompt", "not-required", "unknown"]
          },
          "reason": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": ["name", "support", "permission"],
        "additionalProperties": false
      }
    }
  }
}
