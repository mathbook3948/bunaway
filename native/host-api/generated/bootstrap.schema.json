{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entrypoint": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/)[^\\u0000\\r\\n]+$(?![\\s\\S])",
      "maxLength": 4096
    },
    "buildId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 128
    },
    "policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "views": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
                "maxLength": 128
              },
              "origins": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^https?://[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[1-9][0-9]{0,4})?$(?![\\s\\S])",
                  "maxLength": 256
                }
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
                  "maxLength": 128
                },
                "maxItems": 256,
                "uniqueItems": true
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
                  "maxLength": 128
                },
                "maxItems": 256,
                "uniqueItems": true
              },
              "host": {
                "type": "object",
                "properties": {
                  "log": {
                    "type": "boolean"
                  },
                  "windows": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
                      "maxLength": 128
                    }
                  },
                  "storage": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "properties": {
                        "scope": {
                          "enum": ["appData", "temp"]
                        },
                        "pathPrefix": {
                          "type": "string",
                          "pattern": "^(?:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*)?$(?![\\s\\S])",
                          "maxLength": 256
                        },
                        "access": {
                          "type": "array",
                          "items": {
                            "enum": ["read", "write"]
                          },
                          "minItems": 1,
                          "maxItems": 2,
                          "uniqueItems": true
                        }
                      },
                      "required": ["scope", "pathPrefix", "access"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["log", "storage"],
                "additionalProperties": false
              }
            },
            "required": ["id", "origins", "commands", "events", "host"],
            "additionalProperties": false
          }
        },
        "backend": {
          "type": "object",
          "properties": {
            "log": {
              "type": "boolean"
            },
            "windows": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
                "maxLength": 128
              }
            },
            "storage": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "scope": {
                    "enum": ["appData", "temp"]
                  },
                  "pathPrefix": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*)?$(?![\\s\\S])",
                    "maxLength": 256
                  },
                  "access": {
                    "type": "array",
                    "items": {
                      "enum": ["read", "write"]
                    },
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true
                  }
                },
                "required": ["scope", "pathPrefix", "access"],
                "additionalProperties": false
              }
            }
          },
          "required": ["log", "storage"],
          "additionalProperties": false
        }
      },
      "required": ["version", "views", "backend"],
      "additionalProperties": false
    },
    "backendContext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$(?![\\s\\S])",
      "maxLength": 128
    }
  },
  "required": ["entrypoint", "buildId"],
  "additionalProperties": false
}
