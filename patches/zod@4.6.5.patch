@@ -1278,3 +1278,9 @@ export function constantCatch<T>(value: T): () => T {
   (fn as { [CONSTANT_CATCH]?: boolean })[CONSTANT_CATCH] = true;
   return fn;
 }
+
+// A sibling may throw before its parent collects this work. The original Promise still rejects.
+export function observe<T>(value: T): T {
+  if (value instanceof Promise) void value.catch(() => {});
+  return value;
+}
