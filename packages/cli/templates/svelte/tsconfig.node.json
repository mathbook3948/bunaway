{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"],
    "allowJs": true,
    "checkJs": true,
    "customConditions": ["bun"]
  },
  "include": ["vite.config.ts", "svelte.config.js"]
}
