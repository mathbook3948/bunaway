{
  "name": "bunaway-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "vue-tsc --project tsconfig.json && tsc --project src-bunaway/tsconfig.json && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "bunaway": "bunaway",
    "typecheck": "vue-tsc --project tsconfig.json && tsc --project src-bunaway/tsconfig.json"
  },
  "dependencies": {
    "@bunaway/backend": "0.0.0",
    "@bunaway/client": "0.0.0",
    "@bunaway/runtime-bun": "0.0.0",
    "@bunaway/core": "0.0.0",
    "vue": "3.5.42",
    "@bunaway/plugin-storage": "0.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "6.0.2",
    "@bunaway/cli": "0.0.0",
    "vite": "8.3.3",
    "@vitejs/plugin-vue": "6.0.8",
    "vue-tsc": "3.3.11"
  }
}
