<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundled Bun under hardened runtime needs allow-jit; without it the
	     measured interpreter fallback is ~22x slower. Oven's stock signature
	     also carries allow-unsigned-executable-memory, but bunaway's Bun
	     measured full-speed with allow-jit alone (see
	     docs/architecture/macos-sandbox-results.md). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
