{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/vendor",
      "!packages/cli/templates/vite/src",
      "!packages/cli/templates/vite/public",
      "!packages/cli/templates/react/src",
      "!packages/cli/templates/react/public",
      "!packages/cli/templates/vue/src",
      "!packages/cli/templates/vue/public",
      "!packages/cli/templates/svelte/src",
      "!packages/cli/templates/svelte/public",
      "!.claude/skills/rigor-mode/scripts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "useTemplate": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "expand": "always",
      "attributePosition": "multiline",
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["tests/conformance/complexity-baseline.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/plugin-api/src/**",
        "!packages/plugin-api/src/host.ts",
        "packages/client-sdk/src/**",
        "packages/plugin-sdk/src/**",
        "!packages/plugin-sdk/src/bun.ts",
        "!packages/plugin-sdk/src/win32.ts",
        "!packages/plugin-sdk/src/windows-*.ts",
        "packages/protocol/src/**",
        "plugins/*/src/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Not defined in WebView bundles. Use Uint8Array, DataView, atob and btoa, or move the code under src/platforms/.",
                  "Bun": "Not defined in WebView bundles. Move Bun-only code under src/platforms/ or behind the plugin SDK transport.",
                  "process": "Not defined in WebView bundles. Platform choices belong in src/platforms/ or the plugin SDK."
                }
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "docs/site/scripts/check-reference.mjs",
        "native/host-api/bun/io-worker.ts",
        "native/macos/bun/backend.ts",
        "native/macos/bun/entry.ts",
        "native/windows/bun/entry.ts",
        "native/windows/bun/job.ts",
        "native/windows/bun/system-events.ts",
        "native/windows/bun/web-assets.ts",
        "native/windows/bun/webview.ts",
        "native/windows/bun/window-events.ts",
        "packages/cli/scripts/pack.ts",
        "packages/packaging/src/channels/windows/inno.ts",
        "packages/protocol/src/validation.ts",
        "packages/runtime-bun/src/runtime.ts",
        "packages/runtime-bun/src/view-boundary.ts",
        "packages/runtime-bun/src/window-config.ts",
        "plugins/opener/src/platforms/macos-file.ts",
        "plugins/opener/src/platforms/windows-file.ts",
        "plugins/opener/src/platforms/windows-shell.ts",
        "plugins/process/src/platforms/windows-process-native.ts",
        "plugins/windows/src/platforms/coordinator.ts",
        "plugins/windows/src/platforms/native-adapter.ts",
        "tests/api/window-geometry.test.ts",
        "tests/cli/distribution.test.ts",
        "tests/cli/managed-command.test.ts",
        "tests/fixtures/macos-image.ts",
        "tests/fixtures/macos-io/probe.ts",
        "tests/fixtures/macos-startup-diagnostics.ts",
        "tests/fixtures/notification-toast-ffi.ts",
        "tests/lifecycle/windows-activation.test.ts",
        "tests/lifecycle/windows-bun-storage.ts",
        "tests/lifecycle/windows-clipboard.test.ts",
        "tests/lifecycle/windows-desktop.ts",
        "tests/lifecycle/windows-geometry.test.ts",
        "tests/lifecycle/windows-size-constraints.test.ts",
        "tests/lifecycle/windows-webview-downloads.ts",
        "tests/lifecycle/windows-windowless.ts",
        "tests/packaging/windows-associations.test.ts",
        "tests/packaging/windows.test.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
