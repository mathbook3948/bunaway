{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/vendor",
      "!packages/cli/templates/vite/src",
      "!packages/cli/templates/vite/public",
      "!packages/cli/templates/react/src",
      "!packages/cli/templates/react/public",
      "!packages/cli/templates/vue/src",
      "!packages/cli/templates/vue/public",
      "!packages/cli/templates/svelte/src",
      "!packages/cli/templates/svelte/public",
      "!.claude/skills/rigor-mode/scripts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useBlockStatements": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "useTemplate": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "expand": "always",
      "attributePosition": "multiline",
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["tests/conformance/complexity-baseline.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/plugin-api/src/**",
        "!packages/plugin-api/src/host.ts",
        "packages/client-sdk/src/**",
        "packages/plugin-sdk/src/**",
        "!packages/plugin-sdk/src/bun.ts",
        "!packages/plugin-sdk/src/win32.ts",
        "!packages/plugin-sdk/src/windows-*.ts",
        "packages/protocol/src/**",
        "plugins/*/src/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Not defined in WebView bundles. Use Uint8Array, DataView, atob and btoa, or move the code under src/platforms/.",
                  "Bun": "Not defined in WebView bundles. Move Bun-only code under src/platforms/ or behind the plugin SDK transport.",
                  "process": "Not defined in WebView bundles. Platform choices belong in src/platforms/ or the plugin SDK."
                }
              }
            }
          },
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    }
  ]
}
